{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.astro",
      "!**/.wrangler",
      "!**/fixtures",
      "!pnpm-lock.yaml",
      "!**/drizzle/meta",
      "!**/worker-configuration.d.ts"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } }
}
