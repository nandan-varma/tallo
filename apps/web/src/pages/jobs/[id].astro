---
import { JobFacts } from "@/components/JobFacts";
import { Button } from "@/components/ui/button";
import { JobMeta } from "@/components/JobMeta";
import { Variants } from "@/components/Variants";
import Base from "@/layouts/Base.astro";
import { getJob } from "@/lib/api";
const id = Number(Astro.params.id);
const job = Number.isInteger(id) ? await getJob(id) : null;
if (!job) return Astro.redirect("/?missing=true");
const link = job.applyUrl ?? job.url;
---
<Base title={`${job.title} · ${job.company} — Tallo`}>
  <div class="standalone">
    <nav aria-label="Breadcrumb" class="standalone-breadcrumb">
      <a href="/">← Jobs</a>
      <span>/</span>
      <span>{job.company}</span>
    </nav>
    <div class="standalone-grid">
      <article>
        <header>
          <p class="text-sm text-muted-foreground">{job.company}</p>
          <h1 class="standalone-heading">{job.title}</h1>
          <JobMeta job={job} extended />
        </header>
        <div class="standalone-description">
          {job.description ?? "The full job description is available on the company’s website."}
        </div>
      </article>
      <aside aria-label="Apply and role facts" class="standalone-aside">
        {
          link && (
            <Button asChild className="w-full">
              <a href={link} rel="noopener noreferrer" target="_blank">
                Apply on company website <span aria-hidden="true">↗</span>
              </a>
            </Button>
          )
        }
        <Button asChild variant="outline" className="w-full">
          <a href={`/resume/${job.id}?tailor=1`}>Tailor resume to this role</a>
        </Button>
        <Variants variants={job.variants} currentId={job.id} />
        <JobFacts facts={job.facts} />
      </aside>
    </div>
  </div>
</Base>
