{
  "name": "tallo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false 2>/dev/null || pnpm -r typecheck",
    "test": "vitest run",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "check": "pnpm lint && pnpm -r typecheck && pnpm test",
    "release": "pnpm check && pnpm --filter @tallo/api migrate && pnpm --filter @tallo/api deploy && pnpm --filter @tallo/web deploy && node scripts/smoke.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
