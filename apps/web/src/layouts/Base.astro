---
import { ClientRouter } from "astro:transitions";
import "@/styles/global.css";
interface Props {
  title?: string;
}
const { title = "Jobs · Tallo" } = Astro.props;
const savedView = Astro.url.searchParams.has("saved");
const jobsActive = Astro.url.pathname === "/" && !savedView;
const statusActive = Astro.url.pathname === "/status";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#fafafa" />
    <meta name="description" content="Search tech jobs, save roles, and apply directly with the company." />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header" transition:name="site-header">
      <a href="/" class="wordmark" aria-label="Tallo home">tallo</a>
      <nav aria-label="Main navigation" class="header-nav">
        <a href="/" aria-current={jobsActive ? "page" : undefined}>Jobs</a>
        <a href="/?saved=true" aria-current={savedView ? "page" : undefined}>Saved jobs</a>
        <a href="/status" aria-current={statusActive ? "page" : undefined}>Status</a>
      </nav>
    </header>
    <main id="main" transition:animate="fade"><slot /></main>
  </body>
</html>
