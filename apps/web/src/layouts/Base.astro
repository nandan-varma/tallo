---
import "@/styles/global.css";

interface Props {
  title?: string;
  /** Only the home page is indexed; results and the rest stay noindex. */
  indexable?: boolean;
  description?: string;
}
const pathname = Astro.url.pathname;
const {
  title = "Tallo",
  indexable = false,
  description = "Find jobs and apply on the employer's own page.",
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Tallo for AI assistants (llms.txt)" />
    <meta name="robots" content={indexable ? "index, follow" : "noindex"} />
    <meta name="theme-color" content="#f8f9f6" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        // The theme follows the system setting; there is no toggle.
        const dark = matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute("content", dark ? "#09090b" : "#f8f9f6");
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="wordmark" aria-label="Tallo home">tallo<span aria-hidden="true">.</span></a>
        <nav aria-label="Main navigation" class="main-nav">
          <a href="/" aria-current={pathname === "/" ? "page" : undefined}>Find jobs</a>
          <a href="/status" aria-current={pathname === "/status" ? "page" : undefined}>Catalog status</a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer print:hidden">
      <div><a href="/" class="font-semibold">tallo.</a><p>Direct from company job boards. Always yours to explore.</p></div>
      <nav aria-label="Footer navigation">
        <a href="/">Search</a>
        <a href="/status">Status</a>
        <a href="/llms.txt">llms.txt</a>
        <a href="/v1/openapi.json">OpenAPI</a>
      </nav>
    </footer>
  </body>
</html>
