---
import { JobMeta } from "@/components/JobMeta";
import { Button } from "@/components/ui/button";
import { Separator } from "@/components/ui/separator";
import Base from "@/layouts/Base.astro";
import { getJob } from "@/lib/api";

const id = Number(Astro.params.id);
const job = Number.isInteger(id) ? await getJob(id) : null;
if (!job) return new Response("Not found", { status: 404 });
const link = job.applyUrl ?? job.url;
---
<Base title={`${job.title} · ${job.company}`}>
  <a href="/" class="text-sm text-muted-foreground hover:underline">← Results</a>
  <div class="grid gap-3">
    <h1 class="text-2xl font-semibold tracking-tight">{job.title}</h1>
    <JobMeta job={job} extended />
    {link && (
      <div>
        <Button asChild><a href={link} rel="noopener noreferrer" target="_blank">Apply on {job.company}'s site ↗</a></Button>
      </div>
    )}
  </div>
  <Separator />
  <div class="whitespace-pre-wrap break-words text-sm leading-relaxed">{job.description ?? "Description unavailable."}</div>
</Base>
