---
import { SearchForm } from "@/components/SearchForm";
import Base from "@/layouts/Base.astro";
import { valuesFrom } from "@/lib/search";

const empty = valuesFrom(new URLSearchParams());
---
<Base title="Tallo · Find jobs">
  <section class="mx-auto grid max-w-3xl gap-8 px-6 py-16">
    <div class="grid gap-3">
      <h1 class="text-3xl font-semibold tracking-tight">Find the role, apply on the employer's page.</h1>
      <p class="text-muted-foreground">
        Tallo collects postings straight from company job boards. Every result links to the employer's own application.
      </p>
    </div>
    <SearchForm values={empty} autoFocus />
  </section>
</Base>
