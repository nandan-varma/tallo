---
import { CollectionSummary } from "@/components/CollectionSummary";
import { PlatformTable } from "@/components/PlatformTable";
import { RunIssuesTable } from "@/components/RunIssuesTable";
import { SourceHealthTable } from "@/components/SourceHealthTable";
import Base from "@/layouts/Base.astro";
import { listAttentionRuns, listSources } from "@/lib/api";
import { attentionSources, summarizeByPlatform, summarizeSources } from "@/lib/status";

const now = Math.floor(Date.now() / 1000);
const [sources, runs] = await Promise.all([listSources(), listAttentionRuns()]);
const summary = summarizeSources(sources);
const platforms = summarizeByPlatform(sources);
const attention = attentionSources(sources);
const names = Object.fromEntries(sources.map((source) => [source.id, source.company]));
---

<Base title="Source status · Tallo">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-8 sm:px-6">
    <header class="grid gap-1">
      <h1 class="font-heading text-2xl font-semibold tracking-tight">Source status</h1>
      <p class="text-sm text-muted-foreground">
        Collection health for every configured board. Freshness is inferred from when each board
        was last listed.
      </p>
    </header>

    <CollectionSummary summary={summary} now={now} />

    <section class="grid gap-3" aria-labelledby="platforms-heading">
      <h2 id="platforms-heading" class="text-base font-medium">By platform</h2>
      <PlatformTable platforms={platforms} now={now} />
    </section>

    <section class="grid gap-3" aria-labelledby="attention-heading">
      <h2 id="attention-heading" class="text-base font-medium">Sources needing attention</h2>
      {
        attention.sources.length === 0 ? (
          <p class="text-sm text-muted-foreground">No stale, hidden or partial sources.</p>
        ) : (
          <>
            {attention.total > attention.sources.length && (
              <p class="text-sm text-muted-foreground">
                Showing the oldest {attention.sources.length} of {attention.total}.
              </p>
            )}
            <SourceHealthTable sources={attention.sources} now={now} />
          </>
        )
      }
    </section>

    <section class="grid gap-3" aria-labelledby="runs-heading">
      <h2 id="runs-heading" class="text-base font-medium">Recent run issues</h2>
      {
        runs.length === 0 ? (
          <p class="text-sm text-muted-foreground">No partial runs or run issues recorded.</p>
        ) : (
          <RunIssuesTable runs={runs} names={names} now={now} />
        )
      }
    </section>
  </div>
</Base>
