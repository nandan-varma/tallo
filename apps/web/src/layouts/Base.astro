---
import "@/styles/global.css";

interface Props {
  title?: string;
  /** Only the home page is indexed; results and the rest stay noindex. */
  indexable?: boolean;
}
const { title = "Tallo", indexable = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={indexable ? "index, follow" : "noindex"} />
    <meta name="theme-color" content="#fafafa" />
    <meta name="description" content="Find jobs and apply on the employer's own page." />
    <title>{title}</title>
    <script is:inline>
      (() => {
        // The theme follows the system setting; there is no toggle.
        const dark = matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute("content", dark ? "#09090b" : "#fafafa");
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header">
      <a href="/" class="wordmark" aria-label="Tallo home">tallo</a>
    </header>
    <main id="main"><slot /></main>
  </body>
</html>
