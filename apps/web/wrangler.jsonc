{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tallo-web",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "routes": [{ "pattern": "tallo.nandan.fyi", "custom_domain": true }],
  "services": [{ "binding": "API", "service": "tallo-api" }],
  // Per-address budget for the public API and the search page (see lib/public.ts). Counters are per Cloudflare
  // location, so the global ceiling is higher than this number. namespace_id is ours: no other limiter may share it.
  "ratelimits": [
    { "name": "PUBLIC_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }
  ]
}
