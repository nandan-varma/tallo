---
import { Assistant } from "@/components/assistant/Assistant";
import Base from "@/layouts/Base.astro";
import { getProfile } from "@/lib/api";

// A missing profile only changes the empty state, so a failed read must not take the page down.
const profile = await getProfile().catch(() => null);
---
<Base title="Tallo">
  <Assistant client:only="react" hasProfile={Boolean(profile?.profile.trim())} />
</Base>
