{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tallo-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "limits": { "cpu_ms": 120000 },
  "routes": [{ "pattern": "tallo-api.nandan.fyi", "custom_domain": true }],
  "triggers": { "crons": ["*/5 * * * *", "17 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tallo",
      "database_id": "001b036c-2e15-45c8-9284-edb9d374b849",
      "migrations_dir": "../../packages/db/drizzle"
    }
  ],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "tallo-blobs" }],
  "queues": {
    "producers": [{ "binding": "COLLECT", "queue": "tallo-collect" }],
    "consumers": [
      {
        "queue": "tallo-collect",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_retries": 2,
        "dead_letter_queue": "tallo-collect-dlq",
        "max_concurrency": 8
      }
    ]
  },
  "durable_objects": { "bindings": [{ "name": "HOST_GATE", "class_name": "HostGate" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HostGate"] }],
  "vars": {
    "READS_BLOCKED_HOST": "tallo-api.nandan.fyi",
    "COLLECT_ENABLED": "0",
    "COLLECT_BATCH": "40",
    "COLLECT_SLICE_SUBREQUESTS": "800",
    "COLLECT_SLICE_MS": "300000"
  }
}
