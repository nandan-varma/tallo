---
import "@/styles/global.css";

interface Props {
  title?: string;
}
const { title = "Tallo" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <script is:inline>
      if (matchMedia("(prefers-color-scheme: dark)").matches) {
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-background text-foreground">
    <a
      href="#main"
      class="sr-only rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50"
    >
      Skip to content
    </a>
    <header
      class="sticky top-0 z-40 border-b border-border bg-background/90 backdrop-blur supports-[backdrop-filter]:bg-background/75"
    >
      <div class="mx-auto flex h-14 w-full max-w-7xl items-center px-4 sm:px-6 lg:px-8">
        <a
          href="/"
          class="flex items-center gap-2.5 text-base font-semibold tracking-tight transition-opacity hover:opacity-80"
        >
          <span
            aria-hidden="true"
            class="grid size-7 shrink-0 place-items-center rounded-md bg-primary font-mono text-sm font-bold text-primary-foreground"
          >
            T
          </span>
          Tallo
        </a>
        <span class="mx-3 hidden text-xs text-muted-foreground sm:inline">·</span>
        <span class="hidden text-xs text-muted-foreground sm:inline">Tech jobs, parsed</span>
        <nav aria-label="Main" class="ml-auto flex items-center gap-1">
          <a
            href="/"
            class="rounded-md px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
          >
            Browse
          </a>
        </nav>
      </div>
    </header>
    <main id="main" class="mx-auto w-full max-w-7xl flex-1 px-4 py-6 sm:px-6 sm:py-8 lg:px-8">
      <slot />
    </main>
    <footer class="mt-10 border-t border-border">
      <div
        class="mx-auto flex w-full max-w-7xl flex-wrap items-center justify-between gap-2 px-4 py-4 text-xs text-muted-foreground sm:px-6 lg:px-8"
      >
        <span>Tallo · parsed job facts</span>
        <span>Data refreshes hourly</span>
      </div>
    </footer>
  </body>
</html>
