---
import Base from "@/layouts/Base.astro";
---
<Base title="Not found · Tallo">
  <div class="mx-auto flex max-w-sm flex-col items-center px-6 py-24 text-center">
    <p class="eyebrow">404 · Page not found</p>
    <h1 class="mt-4 text-3xl font-semibold tracking-tight">A little off track.</h1>
    <p class="mt-3 text-muted-foreground">That page doesn't exist. Your next role might.</p>
    <a href="/" class="mt-6 inline-flex min-h-11 items-center rounded-lg bg-primary px-5 text-sm font-medium text-primary-foreground hover:opacity-90">Find jobs</a>
  </div>
</Base>
