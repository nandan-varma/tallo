---
import Base from "@/layouts/Base.astro";
---
<Base title="Not found · Tallo">
  <div class="mx-auto flex max-w-sm flex-col items-center px-6 py-24 text-center">
    <p class="text-sm font-medium">That page doesn't exist.</p>
    <p class="mt-1 text-[13px] text-muted-foreground">Find a role, or open your resume.</p>
    <div class="mt-5 flex gap-2">
      <a href="/" class="rounded-lg border px-3 py-1.5 text-sm hover:bg-muted">Jobs</a>
      <a href="/resume" class="rounded-lg border px-3 py-1.5 text-sm hover:bg-muted">Resume</a>
    </div>
  </div>
</Base>
