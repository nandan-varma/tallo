---
import { ResumeWorkspace } from "@/components/resume/ResumeWorkspace";
import Base from "@/layouts/Base.astro";
import { getJob, getProfile, getResume, listResumes } from "@/lib/api";

// /resume is the base resume; /resume/<posting id> is the copy tailored to that posting.
const param = Astro.params.job;
const jobId = param === undefined ? null : /^\d+$/.test(param) ? Number(param) : Number.NaN;
if (Number.isNaN(jobId)) return Astro.redirect("/resume");

const job = jobId ? await getJob(jobId).catch(() => null) : null;
if (jobId && !job) return Astro.redirect("/resume");

// The resume is personal data: a failed read must say so, not look like an empty resume that gets overwritten.
const [initial, base, copies, profile] = await Promise.all([
  getResume(jobId),
  jobId ? getResume() : null,
  listResumes(),
  getProfile().catch(() => null),
]);
const posting = job ? { id: job.id, title: job.title, company: job.company } : null;
---
<Base title={posting ? `Resume for ${posting.company} · Tallo` : "Resume · Tallo"}>
  <ResumeWorkspace
    client:only="react"
    initial={initial}
    base={base ?? initial}
    posting={posting}
    copies={copies}
    profileText={profile?.resume ?? ""}
    autoTailor={Astro.url.searchParams.get("tailor") === "1"}
  />
</Base>
