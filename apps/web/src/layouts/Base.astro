---
import "@/styles/global.css";

interface Props {
  title?: string;
}
const { title = "Tallo" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.classList.toggle("dark", matchMedia("(prefers-color-scheme: dark)").matches);
    </script>
  </head>
  <body class="mx-auto min-h-screen max-w-3xl px-4 pb-16 pt-6">
    <header class="mb-6">
      <a href="/" class="text-lg font-bold tracking-tight">Tallo</a>
    </header>
    <main class="grid gap-6"><slot /></main>
  </body>
</html>
