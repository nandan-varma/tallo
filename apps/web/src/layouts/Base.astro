---
import "@/styles/global.css";

interface Props {
  title?: string;
  /** Only the home page is indexed; results and the rest stay noindex. */
  indexable?: boolean;
  description?: string;
}
const pathname = Astro.url.pathname;
const {
  title = "Tallo",
  indexable = false,
  description = "Find jobs and apply on the employer's own page.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="alternate"
      type="text/plain"
      href="/llms.txt"
      title="Tallo for AI assistants (llms.txt)"
    />
    <meta name="robots" content={indexable ? "index, follow" : "noindex"} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        // The theme follows the system setting; there is no toggle.
        const dark = matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute("content", dark ? "#0a0a0a" : "#ffffff");
      })();
    </script>
  </head>
  <body class="flex min-h-svh flex-col antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-foreground"
    >
      Skip to content
    </a>
    <header class="border-b print:hidden">
      <div class="mx-auto flex min-h-14 max-w-3xl items-center justify-between gap-4 px-4 sm:px-6">
        <a
          href="/"
          class="text-lg font-semibold tracking-tight"
          aria-label="Tallo home"
        >
          tallo
        </a>
        <nav
          aria-label="Main navigation"
          class="flex items-center gap-4 text-sm"
        >
          <a
            href="/"
            class="py-3 text-muted-foreground hover:text-foreground aria-[current=page]:text-foreground"
            aria-current={pathname === "/" ? "page" : undefined}
          >
            Search
          </a>
          <a
            href="/status"
            class="py-3 text-muted-foreground hover:text-foreground aria-[current=page]:text-foreground"
            aria-current={pathname === "/status" ? "page" : undefined}
          >
            Status
          </a>
        </nav>
      </div>
    </header>
    <main id="main" class="min-w-0 flex-1">
      <slot />
    </main>
    <footer class="border-t print:hidden">
      <p class="mx-auto max-w-3xl px-4 py-6 text-xs text-muted-foreground sm:px-6">
        Postings are collected from public employer career boards and link to
        the employer's own application page.
        <a
          class="underline underline-offset-2 hover:text-foreground"
          href="https://github.com/nandan-varma/tallo"
        >
          Source (AGPL-3.0)
        </a>
        ·
        <a
          class="underline underline-offset-2 hover:text-foreground"
          href="mailto:contact@nandan.fyi"
        >
          Report a problem or request removal
        </a>
      </p>
    </footer>
  </body>
</html>
