{
  "name": "tallo",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "lint": "biome check . && prettier --check \"apps/web/src/**/*.astro\" \"apps/web/src/**/*.css\"",
    "fix": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "parity": "node scripts/parity.ts",
    "release": "pnpm check && pnpm --filter @tallo/api migrate && pnpm --filter @tallo/api run deploy && pnpm --filter @tallo/web run deploy && node scripts/smoke.ts",
    "format:web": "prettier --write \"apps/web/src/**/*.astro\" \"apps/web/src/**/*.css\""
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
