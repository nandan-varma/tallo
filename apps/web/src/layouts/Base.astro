---
import { ClientRouter } from "astro:transitions";
import "@/styles/global.css";
import { ThemeToggle } from "@/components/ThemeToggle";
interface Props {
  title?: string;
}
const { title = "Jobs · Tallo" } = Astro.props;
const path = Astro.url.pathname;
const current = (active: boolean) => (active ? "page" : undefined);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#fafafa" />
    <meta name="description" content="Find tech jobs by describing the role you want." />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const KEY = "tallo:theme";
        const THEME_COLOR = { light: "#fafafa", dark: "#09090b" };
        const apply = () => {
          let dark = false;
          try {
            const stored = localStorage.getItem(KEY);
            dark = stored ? stored === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
          } catch {
            dark = matchMedia("(prefers-color-scheme: dark)").matches;
          }
          document.documentElement.classList.toggle("dark", dark);
          const meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute("content", dark ? THEME_COLOR.dark : THEME_COLOR.light);
        };
        apply();
        // Guard against a second registration if the head script runs again after a swap.
        if (!window.talloThemeListening) {
          window.talloThemeListening = true;
          document.addEventListener("astro:after-swap", apply);
        }
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header" transition:name="site-header">
      <a href="/" class="wordmark" aria-label="Tallo home">tallo</a>
      <nav aria-label="Main navigation" class="header-nav">
        <a href="/" aria-current={current(path === "/")}>Jobs</a>
        <a href="/resume" aria-current={current(path.startsWith("/resume"))}>Resume</a>
      </nav>
      <div class="header-end">
        <a href="/status" class="header-status" aria-current={current(path === "/status")}>Data status</a>
        <ThemeToggle client:load />
      </div>
    </header>
    <main id="main" transition:animate="fade"><slot /></main>
  </body>
</html>
