---
import { JobCard } from "@/components/JobCard";
import { SearchForm } from "@/components/SearchForm";
import { Button } from "@/components/ui/button";
import Base from "@/layouts/Base.astro";
import { searchJobs } from "@/lib/api";

const params = Astro.url.searchParams;
const query = new URLSearchParams([...params].filter(([, value]) => value !== ""));
const { jobs, nextCursor } = await searchJobs(query);
const more = new URLSearchParams(query);
if (nextCursor) more.set("cursor", nextCursor);
const filtered = [...params].some(
  ([key, value]) => value !== "" && key !== "cursor" && key !== "q",
);
const searching = Boolean(params.get("q"));
---
<Base>
  {/* Two-pane dashboard on desktop: filters rail left, results stage right.
      On phones and tablets it stacks (filters, then results) — same DOM. */}
  <div class="grid gap-6 lg:grid-cols-[minmax(240px,280px)_minmax(0,1fr)] lg:items-start lg:gap-8">
    <aside aria-label="Filters" class="lg:sticky lg:top-20">
      <SearchForm values={Object.fromEntries(params)} />
    </aside>

    <section aria-label="Results" class="min-w-0">
      <div class="mb-4 grid gap-1">
        <h1 class="font-heading text-xl font-semibold tracking-tight sm:text-2xl">
          {searching ? "Results" : "Find your next role"}
        </h1>
        <p class="text-sm text-muted-foreground">
          Tech jobs with parsed pay, experience and location — refreshes hourly.
        </p>
      </div>

      {
        jobs.length === 0 && (
          <div class="rounded-lg border border-dashed border-border bg-muted/30 px-6 py-16 text-center">
            <p class="font-medium text-foreground">No jobs match</p>
            <p class="mx-auto mt-1 max-w-sm text-sm text-muted-foreground">
              Fewer filters or a broader term usually helps.
            </p>
            {(filtered || searching) && (
              <Button variant="outline" size="sm" asChild className="mt-4">
                <a href="/">Reset everything</a>
              </Button>
            )}
          </div>
        )
      }

      {
        jobs.length > 0 && (
          <div class="grid gap-4">
            <div class="flex items-baseline justify-between gap-3 border-b border-border pb-3">
              <h2 class="font-heading text-sm font-medium text-foreground">
                {jobs.length} job{jobs.length === 1 ? "" : "s"} on this page
              </h2>
              {nextCursor && (
                <span class="text-xs text-muted-foreground">pages follow below</span>
              )}
            </div>
            {/* Single-column list: rows share one edge so facts align down the page. */}
            <ul class="list-none overflow-hidden rounded-lg border border-border bg-card">
              {jobs.map((job) => (
                <JobCard job={job} />
              ))}
            </ul>
            {nextCursor && (
              <div class="mt-2 flex justify-center">
                <Button variant="outline" asChild>
                  <a href={`/?${more}`}>Load next page</a>
                </Button>
              </div>
            )}
          </div>
        )
      }
    </section>
  </div>
</Base>
